# ==========================================
# VoC Platform 环境变量示例
# ==========================================
# 复制此文件为 .env 并填入真实值：cp .env.example .env
# .env 文件已被 .gitignore 忽略，不会提交到 Git

# ==========================================
# Steam Web API（必填其一用于Steam采集）
# ==========================================
# 申请地址：https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# ==========================================
# B站采集（可选）
# ==========================================
# 热门视频评论采集需登录 cookie（匿名只返回第 1 页 3 条，风控降级）。
# 获取：浏览器登录 bilibili.com → DevTools → Application → Cookies → SESSDATA。
# 普通视频（评论 < 2000）不配也可采。
BILIBILI_SESSDATA=your_sessdata_here

# ==========================================
# 大模型 API（情感分析用，至少填一个）
# ==========================================

# DeepSeek（备选，主标注器已切换到 GLM-5.3-Flash）
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 通义千问（备选 · 千问AI平台 · Token Plan 个人版）
# 申请地址：https://platform.qianwenai.com/docs/token-plan/personal/token-plan-personal-quickstart
# 注意：Token Plan 的 API Key 以 sk-sp- 开头，与通用 key(sk-ws-) 不通用
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# GLM（智谱AI · 主标注器用 glm-5.3-flash provider；2026-08-31 起切换）
# 申请地址：https://open.bigmodel.cn/
# 凭据来源：Windows 用户变量 glm_api_voc_platform（Windows 大小写不敏感，GLM_API_KEY 直接读到）
# 也可在 .env 写明文（已 .gitignore，作为离线备份）
# GH Secret 命名约定：统一 XXX_API_KEY（与 DEEPSEEK/QWEN/STEAM 一致）
GLM_API_KEY=your_glm_api_key_here
GLM_5_3_FLASH_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_5_3_FLASH_MODEL=glm-5.3-flash
# 旧「glm」provider（GLM-4-Flash）的 base_url/model 保留作备用：
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-4-flash

# 用法：ANALYZER_PROVIDER=glm-5.3-flash python -m src.pipeline ...
# 文档：https://docs.bigmodel.cn/cn/guide/models/vlm/glm-5.3-flash
#      https://docs.bigmodel.cn/cn/api/introduction#python-sdk

# ==========================================
# Web 看板 · 管理员鉴权（src/api/，2026-09-01 新增）
# ==========================================
# 生成密码哈希：python scripts/ops/hash_admin_password.py <密码>
ADMIN_PASSWORD_HASH=
# session cookie 签名密钥（生成：python -c "import secrets;print(secrets.token_hex(32))"）
# 未配置时管理端点不可用（登录报错）
SESSION_SECRET_KEY=
# 经 HTTPS 访问时设 1（cookie 仅经 HTTPS 传输）。
# 公网形态必须为 1：否则 admin session cookie 在明文 HTTP 上裸奔（启动自检会就此告警）。
# 本地 http://127.0.0.1:8000 开发保持 0（设 1 会登不上）。
COOKIE_SECURE=0

# ==========================================
# 限流（2026-09-11 内测加固）
# ==========================================
# 公开只读端点：每 IP 每分钟请求上限（0 = 关闭）
# 覆盖 /api/targets /overview /topics /comments /opinions /compare /trends /wordcloud 等
PUBLIC_RATE_LIMIT_PER_MIN=120
# Agent 端点（chat/sessions/search/export）：每 IP 每分钟请求上限（0 = 关闭）
AGENT_RATE_LIMIT_PER_MIN=30
# Agent 成本熔断（自然日，UTC+8；0 = 关闭）：全局每日 chat 次数 / 单 IP 每日 chat 次数
AGENT_DAILY_CHAT_LIMIT=300
AGENT_DAILY_CHAT_LIMIT_PER_IP=50
# Agent 全局并发：同时在跑的对话流上限（0 = 不限制）；满时排队
AGENT_MAX_CONCURRENCY=2
# 并发满时排队等待上限（秒），超时给前端明确「繁忙」提示
AGENT_QUEUE_WAIT_SEC=20
# 单轮 LLM 输出 token 上限（tool 调用 + 正文共用）
AGENT_MAX_TOKENS=2048

# ==========================================
# 内测加固 · 公网模式与访问审计（2026-09-11 P1）
# ==========================================
# 公网形态开关：设 1 时启动自检「缺件即拒绝启动」（fail-closed），并关闭交互文档
# /docs、/redoc、/openapi.json（避免把 admin 端点清单摊给持准入口令的人）。
# 本地开发保持 0。判定项：SESSION_SECRET_KEY / ADMIN_PASSWORD_HASH 非空、
# AGENT_DAILY_CHAT_LIMIT 与 _PER_IP > 0、ENTRY_AUTH_ENFORCED=1。
PUBLIC_MODE=0
# 展示端开关（2026-09-11）：1 = 本实例只读展示 —— admin 写操作一律 403、
# `pipeline.run_pipeline()` 拒绝采集与标注。收口的是「线上 admin 页看着能采」陷阱：
# 在 VPS 上真跑采集会烧 token，结果次日又被整库推送覆盖（白干），且 VPS 无生产标注器
# Key → `get_analyzer()` 回落到 deepseek，写脏 `analyzer_version`。
# 默认【不写这一行】= 跟随 PUBLIC_MODE（公网形态自动是展示端，少一个能忘的开关）。
# 只有确需一台**可写的**公网实例（例如将来改成 VPS 自己采集）才显式写 0。
#DISPLAY_ONLY=0
# 显式声明上游已启用全站准入口令（Caddy basicauth，§7A）。应用进程无法自证，
# 故要求操作者声明，避免"以为锁了其实没锁"。PUBLIC_MODE=1 时必为 1，否则拒绝启动。
ENTRY_AUTH_ENFORCED=0
# 访问审计开关（0 = 关闭）。内测期是观察期，靠它定阈值、出事后溯源。
ACCESS_LOG_ENABLED=1
# 审计库路径（**与主库分开**：主库每天会被本机快照整库覆盖到 VPS，审计表放主库会被清空）
ACCESS_LOG_DB=data/access_log.db
# 审计行保留天数（≤0 = 不清理）
ACCESS_LOG_RETENTION_DAYS=30
# 后台批量落库间隔（秒）；请求路径只写内存缓冲，不阻塞业务
ACCESS_LOG_FLUSH_SEC=5

# ==========================================
# 应用配置
# ==========================================
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 数据库路径（默认使用 SQLite）
DATABASE_URL=sqlite:///data/voc.db

# 默认使用的分析器：deepseek / qwen / glm / glm-5.3-flash / local
ANALYZER_PROVIDER=glm-5.3-flash

# ==========================================
# 语义向量化（本地 embedding，可选）
# ==========================================
# 默认 BAAI/bge-small-zh-v1.5（512 维，中文，~95MB，零 API 成本）。
# 换模型 = 跑 scripts/ops/backfill_embeddings.py --force 全量重算（衍生数据可重建）。
# 未安装 sentence-transformers 时 pipeline 自动跳过向量化，不阻塞主流程。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5