/* 原声分析 Agent · 一级页面（2026-09-09 第 5 轮）
   - 左历史栏（240px，固定宽）+ 主对话窗口（flex:1）
   - 主对话窗口：上下三段（标题栏 + 消息流 + 输入框）
   - 复用 agent-drawer.css 中 .msg / .tool-call 样式（同样的视觉） */

/* ---- 二列布局 ---- */
.agent-page {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 16px;
  min-height: calc(100vh - 60px - 48px);
}
@media (max-width: 900px) {
  .agent-page { grid-template-columns: 1fr; }
  .agent-side { display: none; }
}

/* ---- 侧栏 ---- */
.agent-side {
  background: var(--panel);
  border: 1px solid var(--line2);
  border-radius: var(--r-lg);
  padding: 12px;
  display: flex;
  flex-direction: column;
  height: fit-content;
  max-height: calc(100vh - 120px);
  position: sticky;
  top: 76px;
}
.agent-side-head { flex: none; }
.agent-side-list {
  margin-top: 12px;
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.side-item {
  position: relative;
  padding: 9px 28px 9px 10px;
  border-radius: var(--r-sm);
  cursor: pointer;
  transition: background .12s;
}
.side-item:hover { background: var(--panel2); }
/* 2026-09-10 强化：panel3 背景在深色主题下与 hover 几乎无差 → 左侧色条 + 加粗，一眼可辨 */
.side-item.active {
  background: var(--panel3);
  box-shadow: inset 3px 0 0 var(--primary);
}
.side-item.active .side-item-title { color: var(--primary); font-weight: 600; }
.side-item.active .side-del { opacity: .7; }  /* 当前会话的删除按钮常显（hover 提到 1） */
.side-item-title {
  font-size: 13px;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 3px;
}
.side-item-meta {
  display: flex;
  gap: 6px;
  align-items: center;
  font-size: 11px;
  color: var(--muted);
}
.side-del {
  position: absolute;
  right: 4px;
  top: 6px;
  background: none;
  border: none;
  color: var(--dim);
  font-size: 16px;
  cursor: pointer;
  padding: 0 6px;
  line-height: 1;
  opacity: 0;
  transition: opacity .12s, color .12s;
}
.side-item:hover .side-del { opacity: 1; }
.side-del:hover { color: var(--neg); }

/* ---- 主对话区 ---- */
.agent-main {
  background: var(--panel);
  border: 1px solid var(--line2);
  border-radius: var(--r-lg);
  display: flex;
  flex-direction: column;
  height: calc(100vh - 120px);
  overflow: hidden;
}
.agent-main-head {
  flex: none;
  padding: 14px 18px;
  border-bottom: 1px solid var(--line2);
  background: var(--panel2);
}
.agent-main-head h2 {
  font-size: 16px;
  font-weight: 600;
  margin: 0 0 3px;
}
.agent-main-head .sub {
  color: var(--muted);
  font-size: 12px;
}

.agent-main-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  background: var(--bg);
}

.agent-main-input {
  flex: none;
  border-top: 1px solid var(--line2);
  padding: 12px 18px 14px;
  background: var(--panel2);
}
.agent-main-input textarea {
  width: 100%;
  min-height: 48px;
  max-height: 180px;
  resize: none;
  background: var(--bg);
  color: var(--ink);
  border: 1px solid var(--line2);
  border-radius: var(--r-md);
  padding: 10px 12px;
  font-family: var(--font-sans);
  font-size: 13.5px;
  line-height: 1.55;
  outline: none;
  box-sizing: border-box;
}
.agent-main-input textarea:focus { border-color: var(--primary); }
.agent-main-input .input-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8px;
  gap: 10px;
}
.agent-main-input .input-bar .hint {
  color: var(--dim);
  font-size: 11.5px;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.agent-main-input .foot-privacy {
  margin-top: 6px;
  font-size: 10.5px;
  color: var(--dim);
  text-align: center;
}

/* ---- 冷启动示例 chip ---- */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  padding: 4px 0 0;
}
.chip-label {
  font-size: 12px;
  color: var(--muted);
}
.chip {
  background: var(--panel2);
  color: var(--ink2);
  border: 1px solid var(--line2);
  border-radius: 99px;
  padding: 6px 14px;
  font-size: 12.5px;
  cursor: pointer;
  font-family: var(--font-sans);
  transition: background .15s, border-color .15s, color .15s;
}
.chip:hover {
  background: var(--panel3);
  border-color: var(--primary);
  color: var(--primary);
}

.empty-sm {
  color: var(--muted);
  font-size: 12px;
  padding: 12px;
  text-align: center;
}
